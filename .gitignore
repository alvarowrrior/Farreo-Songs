# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
/.idea/
*.jks
*.keystore

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# Backend: versionamos el codigo, pero no secretos,
# dependencias ni almacenamiento generado.

/backend/node_modules/
/backend/almacenamiento_compartido/

/backend/*.json
!/backend/package.json
!/backend/package-lock.json

/backend/.env
!/backend/.env.example

# typescript
*.tsbuildinfo
next-env.d.ts
/backend_bot_discord/

# El codigo del backend si se versiona, pero no sus secretos, sus dependencias
# ni la biblioteca de musica que genera en tiempo de ejecucion.
/backend/node_modules/
/backend/almacenamiento_compartido/
/backend/*.json
!/backend/package.json
!/backend/package-lock.json

# Android SDK path is machine-specific.
/android/local.properties

# Binario que /tools descarga bajo demanda.
/.ytdlp/
