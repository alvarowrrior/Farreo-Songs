# Puerto del backend de música
PORT=3001

# Recomendado: ruta absoluta al JSON de service account de Firebase Admin.
# Ejemplo en Linux:
# FIREBASE_SERVICE_ACCOUNT_PATH=/opt/farreo/firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_PATH=

# Alternativa: pegar el JSON completo de Firebase Admin en una sola línea.
# Si usas esta, deja FIREBASE_SERVICE_ACCOUNT_PATH vacío.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"farreo-d315c",...}
FIREBASE_SERVICE_ACCOUNT_JSON=

# Alternativa avanzada: credenciales por defecto de Google.
# GOOGLE_APPLICATION_CREDENTIALS=/opt/farreo/firebase-service-account.json
GOOGLE_APPLICATION_CREDENTIALS=

# Opcional. Normalmente no hace falta si el JSON ya trae project_id.
FIREBASE_PROJECT_ID=farreo-d315c

# El backend genera automaticamente el secreto de visitantes y lo conserva en:
# almacenamiento_compartido/albums/visitor-secret

# Opcional. Lado maximo en pixeles para caratulas/iconos guardados por el backend.
# Si una imagen es menor o igual, se conserva tal cual.
ICON_MAX_DIMENSION=512

# Opcional. Calidad WebP usada solo cuando una imagen supera ICON_MAX_DIMENSION.
ICON_WEBP_QUALITY=82
