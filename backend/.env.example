# Puerto del backend de música
PORT=3001

# Recomendado: ruta absoluta al JSON de service account de Firebase Admin.
# Ejemplo en Linux:
# FIREBASE_SERVICE_ACCOUNT_PATH=/opt/farreo/firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_PATH=

# Alternativa: pegar el JSON completo de Firebase Admin en una sola línea.
# Si usas esta, deja FIREBASE_SERVICE_ACCOUNT_PATH vacío.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"farreo-d315c",...}
FIREBASE_SERVICE_ACCOUNT_JSON=

# Alternativa avanzada: credenciales por defecto de Google.
# GOOGLE_APPLICATION_CREDENTIALS=/opt/farreo/firebase-service-account.json
GOOGLE_APPLICATION_CREDENTIALS=

# Opcional. Normalmente no hace falta si el JSON ya trae project_id.
FIREBASE_PROJECT_ID=farreo-d315c

# Web principal. Se usa para obtener la misma lista de administradores que usa
# Vercel. El backend mantiene esta consulta cacheada durante 5 minutos.
FARREO_WEB_URL=https://farreo.vercel.app

# Fallback local de administradores. Recomendado en el Linux para que el panel
# siga pudiendo autenticarse aunque Vercel este temporalmente caido.
# FARREO_ADMIN_EMAILS=correo1@gmail.com,correo2@gmail.com
FARREO_ADMIN_EMAILS=

# SOLO emergencia/diagnostico. Mantener false normalmente. En true se permite
# usar las antiguas rutas de escritura sin comprobar que el token sea admin.
FARREO_DISABLE_ADMIN_GUARD=false

# El backend genera automaticamente el secreto de visitantes y lo conserva en:
# almacenamiento_compartido/albums/visitor-secret

# Opcional. Lado maximo en pixeles para caratulas/iconos guardados por el backend.
# Si una imagen es menor o igual, se conserva tal cual.
ICON_MAX_DIMENSION=512

# Opcional. Calidad WebP usada solo cuando una imagen supera ICON_MAX_DIMENSION.
ICON_WEBP_QUALITY=82

# ------------------------------------------------------------------
# Limites duros de subida. La capa farreoSafetyPreload los hace cumplir en el
# servidor incluso si el navegador se manipula o no valida el fichero.
# ------------------------------------------------------------------
UPLOAD_MAX_FILE_MB=160
AUDIO_MAX_MB=160
SONG_ICON_MAX_MB=8
ADVANCED_COVER_MAX_MB=64
LYRICS_MAX_MB=2

# ------------------------------------------------------------------
# Descarga de YouTube (apartado "Herramientas" de la web)
# ------------------------------------------------------------------
# Rutas a los binarios. Si estan en el PATH no hace falta tocar nada:
# el servidor los busca con "which".
YTDLP_PATH=
FFMPEG_PATH=

# Descargas simultaneas permitidas. Bajalo a 1 si notas que la musica
# se corta mientras alguien esta descargando.
YOUTUBE_MAX_CONCURRENT=2

# Segundos antes de abortar una descarga atascada.
YOUTUBE_TIMEOUT_SECONDS=600
